  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "run-s build:internal pack",
    "build:internal": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "type-check:watch": "vue-tsc --build --watch",
    "preview": "vite preview",
