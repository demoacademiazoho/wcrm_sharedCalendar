    "server": "zet run",
    "pack": "zet pack",
    "dist": "run-s build pack"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/list": "^6.1.22",
    "@fullcalendar/timegrid": "^6.1.22",
    "@fullcalendar/vue3": "^6.1.22",
    "pinia": "^3.0.4",
    "vue": "^3.5.31"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.4.27",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.9",
    "prettier": "3.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.0",
    "vite": "^8.0.3",
    "vue-tsc": "^3.2.6"
